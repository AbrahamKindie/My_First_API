generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// SYSTEM ROLES
// ==============================

enum Role {
  USER
  SHOP_OWNER
  ADMIN
  SUPER_ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductStatus {
  ACTIVE
  ADMIN_DEACTIVATED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CHAPA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShopStatus {
  ACTIVE
  DEACTIVATED
}

enum ProductReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ProductReportReason {
  COUNTERFEIT
  MISLEADING_INFORMATION
  PROHIBITED_PRODUCT
  SUSPICIOUS_ACTIVITY
  OTHER
}

enum NotificationType {
  FEATURED_PRODUCT
  NEW_DISCOUNT
  DISCOUNT_ENDING_SOON
  NEW_ARRIVAL
  SHOP_APPLICATION_REJECTED

  ORDER_PENDING_REMINDER
  ORDER_AUTO_CANCELLED
  ORDER_CANCELLED_BY_CUSTOMER

  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_REPLY
  SUPPORT_TICKET_STATUS_UPDATED
  SUPPORT_TICKET_ASSIGNED
}

enum OrderEmailJobType {
  PENDING_REMINDER
  AUTO_CANCELLATION
  CUSTOMER_CANCELLATION
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// ==============================
// AI SUPPORT ENUMS
// ==============================

enum AiSupportConversationStatus {
  ACTIVE
  ESCALATED
  CLOSED
}

enum AiSupportMessageRole {
  USER
  ASSISTANT
}

// ==============================
// ADMIN PERMISSION CATALOG
// ==============================

model AdminPermission {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  group       String
  label       String
  description String?
  isActive    Boolean @default(true)

  roles AdminRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, isActive])
  @@index([isActive])
}

// ==============================
// USER
// ==============================

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  // Sorting
  sort_order Int @default(autoincrement())

  // Personal information
  phone        String?  @unique
  dateOfBirth  DateTime
  gender       String
  address      String?
  city         String?
  country      String?
  profileImage String?

  // Account information
  isVerified Boolean @default(false)
  isActive   Boolean @default(true)
  role       Role    @default(USER)

  // Dynamic Admin Role
  adminRoleId Int?
  adminRole   AdminRole? @relation(fields: [adminRoleId], references: [id], onDelete: Restrict)

  // Relationships
  orders                 Order[]
  carts                  Cart[]
  reviews                ProductReview[]
  notifications          Notification[]
  shop                   Shop?
  adminActivityLogs      AdminActivityLog[] @relation("AdminActivityActor")
  productLikes           ProductLike[]
  productReports         ProductReport[]    @relation("ProductReportReporter")
  reviewedProductReports ProductReport[]    @relation("ProductReportReviewer")

  // Human Support
  supportTicketsRequested SupportTicket[]  @relation("SupportTicketRequester")
  supportTicketsAssigned  SupportTicket[]  @relation("SupportTicketAssignee")
  supportMessages         SupportMessage[] @relation("SupportMessageSender")

  // AI Support
  aiSupportConversations AiSupportConversation[]

  // Password reset
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // First-time Admin password setup
  adminPasswordSetupToken     String?   @unique
  adminPasswordSetupExpires   DateTime?
  adminPasswordSetupCompleted Boolean   @default(true)

  // Refresh token
  refreshToken       String?
  refreshTokenExpiry DateTime?

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([adminRoleId])
}

// ==============================
// ADMIN ROLE
// ==============================

model AdminRole {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  permissions AdminRolePermission[]
  admins      User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ==============================
// ADMIN ROLE PERMISSIONS
// ==============================

model AdminRolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

// ==============================
// ADMIN ACTIVITY LOG
// ==============================

model AdminActivityLog {
  id         Int     @id @default(autoincrement())
  actorId    Int?
  action     String
  targetType String?
  targetId   Int?
  details    Json?

  actor     User?    @relation("AdminActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
}

// ==============================
// SHOP CATEGORY
// ==============================

model ShopCategory {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  image       String?

  shops Shop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// PRODUCT CATEGORY
// ==============================

model ProductCategory {
  id          Int     @id @default(autoincrement())
  shopId      Int
  name        String
  description String?

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[] @relation("ProductCategoryProducts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, name])
  @@unique([id, shopId])
  @@index([shopId])
}

// ==============================
// PRODUCT
// ==============================

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  images      String[]

  // Shop ownership
  shopId Int
  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  // Shop-specific product category
  productCategoryId Int
  productCategory   ProductCategory @relation("ProductCategoryProducts", fields: [productCategoryId, shopId], references: [id, shopId], onDelete: Restrict)

  // Relationships
  orderItems OrderItem[]
  cartItems  CartItem[]
  likes      ProductLike[]
  reports    ProductReport[]

  isFeatured Boolean @default(false)

  discount      ProductDiscount?
  reviews       ProductReview[]
  notifications Notification[]
  status        ProductStatus    @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([productCategoryId, shopId])
  @@index([isFeatured])
  @@index([status])
}

// ==============================
// PRODUCT LIKE
// ==============================

model ProductLike {
  id        Int @id @default(autoincrement())
  productId Int
  userId    Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([userId])
}

// ==============================
// PRODUCT REPORT
// ==============================

model ProductReport {
  id        Int @id @default(autoincrement())
  productId Int
  userId    Int

  reason      ProductReportReason
  description String?
  status      ProductReportStatus @default(PENDING)

  adminNote    String?
  reviewedById Int?
  reviewedAt   DateTime?

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter User    @relation("ProductReportReporter", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ProductReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([reviewedById])
}

// ==============================
// PRODUCT DISCOUNT
// ==============================

model ProductDiscount {
  id        Int          @id @default(autoincrement())
  productId Int          @unique
  type      DiscountType
  value     Decimal      @db.Decimal(10, 2)

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ==============================
// PRODUCT REVIEW
// ==============================

model ProductReview {
  id        Int    @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int
  comment   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

// ==============================
// ORDER
// ==============================

model Order {
  id         Int     @id @default(autoincrement())
  userId     Int
  shopId     Int
  totalPrice Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)

  shippingName    String @default("")
  shippingPhone   String @default("")
  shippingAddress String @default("")
  shippingCity    String @default("")
  shippingCountry String @default("Ethiopia")

  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatus @default(PENDING)

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop          Shop            @relation(fields: [shopId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  notifications Notification[]
  emailJobs     OrderEmailJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([shopId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([shopId, status])
}

// ==============================
// ORDER ITEM
// ==============================

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int

  quantity Int
  price    Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}

// ==============================
// CART
// ==============================

model Cart {
  id     Int        @id @default(autoincrement())
  userId Int
  status CartStatus @default(ACTIVE)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, status])
}

// ==============================
// CART ITEM
// ==============================

model CartItem {
  id        Int @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

// ==============================
// NOTIFICATION
// ==============================

model Notification {
  id        Int  @id @default(autoincrement())
  userId    Int
  productId Int?
  orderId   Int?

  type    NotificationType
  title   String
  message String
  link    String?
  isRead  Boolean          @default(false)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  supportTicketId Int?
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orderId, type])
  @@index([supportTicketId])
  @@index([userId, isRead, createdAt])
  @@index([productId])
  @@index([orderId])
}

// ==============================
// SHOP
// ==============================

model Shop {
  id      Int @id @default(autoincrement())
  ownerId Int @unique

  name        String
  description String

  // Admin-managed shop category
  shopCategoryId Int
  shopCategory   ShopCategory @relation(fields: [shopCategoryId], references: [id], onDelete: Restrict)

  logo       String?
  coverImage String?
  address    String?
  city       String?
  region     String?
  phone      String
  email      String?

  status ShopStatus @default(ACTIVE)

  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products          Product[]
  productCategories ProductCategory[]
  orders            Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([shopCategoryId])
}

// ==============================
// ORDER EMAIL JOB
// ==============================

model OrderEmailJob {
  id              Int               @id @default(autoincrement())
  orderId         Int
  recipientUserId Int
  recipientEmail  String
  recipientName   String
  type            OrderEmailJobType
  status          EmailJobStatus    @default(PENDING)
  attempts        Int               @default(0)
  nextAttemptAt   DateTime          @default(now())
  lastError       String?
  sentAt          DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, recipientUserId, type])
  @@index([status, nextAttemptAt])
  @@index([orderId])
}

// ==============================
// SUPPORT TICKET ENUMS
// ==============================

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
  REJECTED
}

enum SupportTicketCategory {
  ACCOUNT
  ORDER
  PAYMENT
  PRODUCT
  SHOP
  SHIPPING
  RETURN_REFUND
  TECHNICAL
  OTHER
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ==============================
// SUPPORT TICKET
// ==============================

model SupportTicket {
  id           Int    @id @default(autoincrement())
  ticketNumber String @unique

  // Registered customer (optional for guest tickets)
  requesterId Int?
  requester   User? @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)

  // Guest customer information
  guestName                 String?
  guestEmail                String?
  guestAccessTokenHash      String?   @unique
  guestAccessTokenExpiresAt DateTime?
  guestEmailVerifiedAt      DateTime?

  // Admin assignment
  assignedAdminId Int?
  assignedAdmin   User? @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  // Plain-text names received from frontend
  shopName    String?
  productName String?

  // Ticket details
  category    SupportTicketCategory
  subject     String
  description String                @db.Text
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(NORMAL)

  // Ticket communication and notifications
  messages         SupportMessage[]
  notifications    Notification[]
  supportEmailJobs SupportEmailJob[]

  // AI conversation escalation
  aiConversation AiSupportConversation?

  resolutionSummary    String?   @db.Text
  rejectionDescription String?   @db.Text
  resolvedAt           DateTime?
  rejectedAt           DateTime?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([requesterId, createdAt])
  @@index([guestEmail, createdAt])
  @@index([assignedAdminId, status])
  @@index([status, createdAt])
  @@index([shopName])
  @@index([productName])
}

// ==============================
// SUPPORT MESSAGE
// ==============================

model SupportMessage {
  id       Int @id @default(autoincrement())
  ticketId Int

  // Null when sender is a guest
  senderId Int?
  sender   User? @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  message        String   @db.Text
  attachmentUrls String[] @default([])

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([senderId])
}

// ==============================
// SUPPORT EMAIL JOB
// ==============================

enum SupportEmailJobStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model SupportEmailJob {
  id       Int  @id @default(autoincrement())
  ticketId Int?

  recipientEmail String
  recipientName  String?

  subject String
  html    String  @db.Text
  text    String? @db.Text

  dedupeKey String @unique

  status      SupportEmailJobStatus @default(PENDING)
  attempts    Int                   @default(0)
  maxAttempts Int                   @default(5)

  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  lastError     String?   @db.Text

  ticket SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([ticketId])
}

// ==============================
// AI SUPPORT CONVERSATION
// ==============================

// ==============================
// AI SUPPORT CONVERSATION
// ==============================

model AiSupportConversation {
  id String @id @default(cuid())

  // Authenticated conversation owner
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Guest conversation authentication
  // Only the SHA-256 hash is stored.
  guestTokenHash      String?   @unique
  guestTokenExpiresAt DateTime?

  // Conversation information
  title  String?
  status AiSupportConversationStatus @default(ACTIVE)

  // Optional human support escalation
  supportTicketId Int?           @unique
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)

  // Conversation messages
  messages AiSupportMessage[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([guestTokenExpiresAt])
}

// ==============================
// AI SUPPORT MESSAGE
// ==============================

model AiSupportMessage {
  id String @id @default(cuid())

  conversationId String

  conversation AiSupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role AiSupportMessageRole

  content String @db.Text

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}
